# Salin menjadi backend/.env. Jangan mengirim berkas .env ke repositori.

# Basis data. Kosongkan untuk memakai SQLite lokal backend/data/monitor.db
# BI_DATABASE_URL=postgresql+psycopg://pengguna:sandi@localhost:5432/media_monitor

# Berita tambahan. NewsAPI paket produksi berbayar; paket gratis terbatas dan tidak untuk produksi.
NEWSAPI_KEY=

# YouTube Data API butuh proyek Google Cloud. Ada kuota gratis, tetapi kunci harus dibuat di akun Google.
YOUTUBE_API_KEY=

# Platform berikut belum punya konektor aktif karena aksesnya berbayar atau butuh persetujuan.
# Jangan mengisi data sosial dengan unggahan karangan.
# X_BEARER_TOKEN=            API X berbayar
# META_ACCESS_TOKEN=        Instagram, Facebook, Threads: butuh app review Meta
# TIKTOK_ACCESS_TOKEN=      TikTok Research/Display API butuh persetujuan
# BRAND24_API_TOKEN=        vendor social listening berlisensi, belum disambungkan
# MELTWATER_API_TOKEN=
# BRANDWATCH_API_TOKEN=
# TALKWALKER_API_TOKEN=

# Set 1 hanya saat uji otomatis agar penjadwal tidak ikut jalan.
BI_DISABLE_SCHEDULER=

# Modul saran AI. Kosongkan LLM_API_KEY untuk memakai penyusun yang hanya menyalin fakta dari database.
# Jika diisi, permintaan memakai API yang kompatibel dengan OpenAI. Keluaran ditolak bila menyebut tautan di luar bukti.
# LLM_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

